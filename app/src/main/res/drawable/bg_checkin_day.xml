<?xml version="1.0" encoding="utf-8"?>
<!-- Ô ngày trong lịch điểm danh: hôm nay viền xanh đậm -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/vego_mint" />
            <stroke android:width="1.5dp" android:color="@color/vego_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/vego_surface" />
            <stroke android:width="1dp" android:color="@color/vego_border" />
        </shape>
    </item>
</selector>
