<?xml version="1.0" encoding="utf-8"?>
<!-- Ô nhập tin nhắn: nền xám nhạt, đang nhập thì viền xanh -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/vego_surface" />
            <stroke android:width="1.5dp" android:color="@color/vego_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/vego_background" />
            <stroke android:width="1dp" android:color="@color/vego_border" />
        </shape>
    </item>
</selector>
