<?xml version="1.0" encoding="utf-8"?>
<!-- Nền trắng có đường kẻ trên 1dp (khung soạn tin nhắn) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vego_border" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/vego_surface" />
        </shape>
    </item>
</layer-list>
