<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ phương thức thanh toán: chọn = nền xanh nhạt, viền xanh 2dp -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vego_ripple_primary">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/vego_mint" />
                    <stroke android:width="2dp" android:color="@color/vego_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/vego_surface" />
                    <stroke android:width="1dp" android:color="@color/vego_border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
