<?xml version="1.0" encoding="utf-8"?>
<!-- Nút "Đổi ngay": xám khi chưa đủ xu -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vego_ripple_light">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/vego_muted" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/vego_primary" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
