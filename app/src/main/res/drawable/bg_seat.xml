<?xml version="1.0" encoding="utf-8"?>
<!-- Ô giường: đã đặt / đang chọn / còn trống -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/vego_chip_bg" />
            <stroke android:width="1dp" android:color="@color/vego_border" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/vego_primary" />
            <stroke android:width="1dp" android:color="@color/vego_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/vego_surface" />
            <stroke android:width="1dp" android:color="@color/vego_primary" />
        </shape>
    </item>
</selector>
