<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ chuyến trong danh sách: khi được chọn thì viền xanh đậm -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vego_ripple_primary">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="@color/vego_surface" />
                    <stroke android:width="2dp" android:color="@color/vego_primary" />
                </shape>
            </item>
            <item android:drawable="@drawable/bg_card" />
        </selector>
    </item>
</ripple>
