<?xml version="1.0" encoding="utf-8"?>
<!-- Chip câu hỏi nhanh: nền trắng viền xám, bo 12dp -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vego_ripple_primary">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/vego_surface" />
            <stroke android:width="1dp" android:color="@color/vego_border" />
        </shape>
    </item>
</ripple>
