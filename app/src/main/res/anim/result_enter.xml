<?xml version="1.0" encoding="utf-8"?>
<!-- Màn kết quả (thành công / thất bại / hết giờ): phóng nhẹ từ giữa -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@android:interpolator/linear_out_slow_in"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.92" android:toXScale="1"
        android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="40%" />
</set>
