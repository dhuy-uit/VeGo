<?xml version="1.0" encoding="utf-8"?>
<!-- Màn chơi "Khủng long phiêu lưu" (không có trong Figma — nằm giữa "Chơi game kiếm xu" và "Kết quả chơi game") -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vego_surface"
    tools:context=".wallet.GameActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/VeGo.Header"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/VeGo.HeaderIconButton"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/VeGo.Text.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/game_name" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:background="@color/vego_background"
        android:divider="@drawable/space_16"
        android:orientation="vertical"
        android:padding="20dp"
        android:showDividers="middle">

        <!-- Điểm / xu / kỷ lục -->
        <LinearLayout
            style="@style/VeGo.Card"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/VeGo.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_hud_score" />

                <TextView
                    android:id="@+id/tv_score"
                    style="@style/VeGo.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/VeGo.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_hud_coins" />

                <TextView
                    android:id="@+id/tv_coins"
                    style="@style/VeGo.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0"
                    android:textColor="@color/vego_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/VeGo.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_hud_best" />

                <TextView
                    android:id="@+id/tv_best"
                    style="@style/VeGo.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/vego_orange_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sân chơi -->
        <com.example.vego.wallet.game.RunnerGameView
            android:id="@+id/game_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_game_stage"
            android:clipToOutline="true"
            android:contentDescription="@string/cd_game_stage" />

        <TextView
            style="@style/VeGo.Text.CenterCaption"
            android:text="@string/game_hint" />
    </LinearLayout>
</RelativeLayout>
