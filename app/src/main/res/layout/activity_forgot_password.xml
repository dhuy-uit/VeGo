<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Tài khoản · Lấy lại mật khẩu" (node 4:62606) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vego_surface"
    tools:context=".auth.ForgotPasswordActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/VeGo.Header"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/VeGo.HeaderIconButton"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/VeGo.Text.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/forgot_title" />
    </LinearLayout>

    <ScrollView
        style="@style/VeGo.ScrollArea"
        android:layout_below="@id/header">

        <LinearLayout style="@style/VeGo.Content">

            <!-- Bảo vệ tài khoản -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_20"
                android:orientation="vertical"
                android:paddingTop="36dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_key_round" />

                <TextView
                    style="@style/VeGo.Text.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_heading" />

                <TextView
                    style="@style/VeGo.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_subtitle" />
            </LinearLayout>

            <!-- Số điện thoại hoặc email -->
            <LinearLayout style="@style/VeGo.Field">

                <TextView
                    style="@style/VeGo.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/et_account"
                    android:text="@string/label_phone_or_email" />

                <RelativeLayout style="@style/VeGo.InputBox">

                    <ImageView
                        android:id="@+id/ic_account"
                        style="@style/VeGo.InputIcon"
                        android:src="@drawable/ic_mail" />

                    <EditText
                        android:id="@+id/et_account"
                        style="@style/VeGo.InputText"
                        android:layout_toStartOf="@id/ic_account"
                        android:autofillHints="emailAddress"
                        android:hint="@string/hint_phone_or_email"
                        android:imeOptions="actionDone"
                        android:inputType="textEmailAddress"
                        android:paddingEnd="10dp"
                        android:text="minhanh@gmail.com" />
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_send"
                style="@style/VeGo.Button.Primary"
                android:text="@string/forgot_button" />

            <!-- Kiểm tra hộp thư -->
            <LinearLayout style="@style/VeGo.InfoBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:divider="@drawable/space_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/VeGo.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_info_title" />

                    <TextView
                        style="@style/VeGo.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_info_body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_back_to_login"
                style="@style/VeGo.Text.CenterLink"
                android:text="@string/forgot_back_to_login" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
