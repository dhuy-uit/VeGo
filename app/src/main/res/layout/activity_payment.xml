<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Đặt vé · Thanh toán" (node 4:63255) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vego_surface"
    tools:context=".booking.PaymentActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/VeGo.Header"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/VeGo.HeaderIconButton"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_left" />

        <LinearLayout style="@style/VeGo.HeaderTitleBlock">

            <TextView
                style="@style/VeGo.Text.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_title" />

            <TextView
                style="@style/VeGo.Text.HeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        style="@style/VeGo.ScrollArea"
        android:layout_below="@id/header">

        <LinearLayout style="@style/VeGo.Content">

            <include
                android:id="@+id/hold_timer"
                layout="@layout/view_hold_timer" />

            <!-- Tóm tắt đơn -->
            <LinearLayout style="@style/VeGo.Card">

                <TextView
                    android:id="@+id/tv_order_title"
                    style="@style/VeGo.Text.BodyStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Phương Trang · Ghế A05" />

                <TextView
                    android:id="@+id/tv_order_route"
                    style="@style/VeGo.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineHeight="19sp"
                    android:textSize="13sp"
                    tools:text="TP. Hồ Chí Minh → Đà Lạt" />

                <com.example.vego.common.widget.InfoRowView
                    android:id="@+id/row_depart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:irLabel="@string/label_depart"
                    app:irValue="22:00 · 18/10/2026" />

                <com.example.vego.common.widget.InfoRowView
                    android:id="@+id/row_fare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:irLabel="@string/label_fare"
                    app:irValue="320.000đ" />

                <com.example.vego.common.widget.InfoRowView
                    android:id="@+id/row_discount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:irLabel="@string/label_discount"
                    app:irValue="-0đ" />

                <com.example.vego.common.widget.InfoRowView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:irLabel="@string/label_service_fee"
                    app:irValue="0đ" />

                <com.example.vego.common.widget.InfoRowView
                    android:id="@+id/row_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:irHighlight="true"
                    app:irLabel="@string/label_total"
                    app:irValue="320.000đ" />
            </LinearLayout>

            <!-- Mã giảm giá -->
            <LinearLayout
                android:id="@+id/card_voucher"
                style="@style/VeGo.Card">

                <TextView
                    style="@style/VeGo.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/et_voucher"
                    android:text="@string/payment_voucher_title" />

                <!-- Ô nhập mã + nút Áp dụng -->
                <RelativeLayout
                    android:id="@+id/voucher_input"
                    style="@style/VeGo.InputBox">

                    <TextView
                        android:id="@+id/btn_apply_voucher"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/voucher_apply"
                        android:textColor="@color/vego_primary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_voucher"
                        style="@style/VeGo.InputText"
                        android:layout_toStartOf="@id/btn_apply_voucher"
                        android:hint="@string/voucher_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="30" />
                </RelativeLayout>

                <!-- Mã đã áp dụng -->
                <RelativeLayout
                    android:id="@+id/voucher_applied"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:minHeight="52dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ic_voucher"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ticket_percent"
                        app:tint="@color/vego_primary" />

                    <TextView
                        android:id="@+id/btn_remove_voucher"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/voucher_remove"
                        android:textColor="@color/vego_danger"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_voucher_applied"
                        style="@style/VeGo.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toStartOf="@id/btn_remove_voucher"
                        android:layout_toEndOf="@id/ic_voucher"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textSize="13sp"
                        tools:text="VEGO10 · Giảm 30.000đ" />
                </RelativeLayout>

                <!-- Gợi ý mã đang có (lấy từ server), bấm để áp dụng -->
                <LinearLayout
                    android:id="@+id/voucher_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/space_8"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/VeGo.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_choose_method" />

            <!-- Các phương thức thanh toán -->
            <LinearLayout
                android:id="@+id/option_momo"
                style="@style/VeGo.PaymentOption">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wallet" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:divider="@drawable/space_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/VeGo.Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MoMo" />

                    <TextView
                        style="@style/VeGo.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_momo_desc" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/radio_momo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_circle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_vnpay"
                style="@style/VeGo.PaymentOption">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_qr_code" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:divider="@drawable/space_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/VeGo.Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VNPay" />

                    <TextView
                        style="@style/VeGo.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_vnpay_desc" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/radio_vnpay"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_circle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_card"
                style="@style/VeGo.PaymentOption">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_credit_card" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:divider="@drawable/space_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/VeGo.Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_card_label" />

                    <TextView
                        style="@style/VeGo.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_card_desc" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/radio_card"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_circle" />
            </LinearLayout>

            <!-- Lời nhắc theo phương thức đang chọn -->
            <LinearLayout style="@style/VeGo.InfoBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:divider="@drawable/space_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/tv_method_info_title"
                        style="@style/VeGo.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Thanh toán bằng MoMo" />

                    <TextView
                        android:id="@+id/tv_method_info_body"
                        style="@style/VeGo.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="@string/payment_info_momo" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_pay"
                style="@style/VeGo.Button.Primary"
                tools:text="Thanh toán MoMo · 320.000đ" />

            <TextView
                android:id="@+id/tv_hold_note"
                style="@style/VeGo.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                tools:text="A05 đang giữ, chưa chuyển thành ghế đã đặt." />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
