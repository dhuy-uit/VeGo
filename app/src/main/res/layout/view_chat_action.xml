<?xml version="1.0" encoding="utf-8"?>
<!-- Thao tác trợ lý đề xuất (đặt / hủy / đổi vé): chỉ khi khách bấm Xác nhận server mới thực hiện -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/VeGo.Card"
    android:divider="@drawable/space_8">

    <TextView
        android:id="@+id/tv_action_title"
        style="@style/VeGo.Text.BodyStrong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Hủy vé VG18102605" />

    <TextView
        android:id="@+id/tv_action_summary"
        style="@style/VeGo.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Hủy vé VG18102605. Hoàn 256.000đ (80% số tiền đã trả)." />

    <TextView
        android:id="@+id/btn_action_confirm"
        style="@style/VeGo.Button.Primary"
        tools:text="Xác nhận hủy vé" />

    <TextView
        android:id="@+id/btn_action_skip"
        style="@style/VeGo.Button.Outline"
        android:text="@string/chat_action_skip" />

    <TextView
        android:id="@+id/tv_action_state"
        style="@style/VeGo.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Đã xác nhận" />
</LinearLayout>
