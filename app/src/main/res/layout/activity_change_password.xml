<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Tài khoản · Đổi mật khẩu" (node 4:62635) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vego_surface"
    tools:context=".account.ChangePasswordActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/VeGo.Header"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/VeGo.HeaderIconButton"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/VeGo.Text.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/change_password_title" />
    </LinearLayout>

    <ScrollView
        style="@style/VeGo.ScrollArea"
        android:layout_below="@id/header">

        <LinearLayout style="@style/VeGo.Content">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_check" />

            <TextView
                style="@style/VeGo.Text.HeadingM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_password_heading" />

            <TextView
                style="@style/VeGo.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_password_subtitle" />

            <!-- Mật khẩu hiện tại -->
            <LinearLayout style="@style/VeGo.Field">

                <TextView
                    style="@style/VeGo.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/et_current_password"
                    android:text="@string/label_current_password" />

                <RelativeLayout style="@style/VeGo.InputBox">

                    <ImageView
                        android:id="@+id/btn_toggle_current"
                        style="@style/VeGo.InputIconButton"
                        android:contentDescription="@string/cd_toggle_password"
                        android:src="@drawable/ic_eye_off" />

                    <EditText
                        android:id="@+id/et_current_password"
                        style="@style/VeGo.InputText"
                        android:layout_toStartOf="@id/btn_toggle_current"
                        android:autofillHints="password"
                        android:hint="@string/hint_current_password"
                        android:inputType="textPassword"
                        android:paddingEnd="2dp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Mật khẩu mới -->
            <LinearLayout style="@style/VeGo.Field">

                <TextView
                    style="@style/VeGo.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/et_new_password"
                    android:text="@string/label_new_password" />

                <RelativeLayout style="@style/VeGo.InputBox">

                    <ImageView
                        android:id="@+id/btn_toggle_new"
                        style="@style/VeGo.InputIconButton"
                        android:contentDescription="@string/cd_toggle_password"
                        android:src="@drawable/ic_eye_off" />

                    <EditText
                        android:id="@+id/et_new_password"
                        style="@style/VeGo.InputText"
                        android:layout_toStartOf="@id/btn_toggle_new"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_new_password"
                        android:inputType="textPassword"
                        android:paddingEnd="2dp" />
                </RelativeLayout>

                <TextView
                    style="@style/VeGo.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/change_password_rule" />
            </LinearLayout>

            <!-- Xác nhận mật khẩu mới -->
            <LinearLayout style="@style/VeGo.Field">

                <TextView
                    style="@style/VeGo.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/et_confirm_password"
                    android:text="@string/label_confirm_new_password" />

                <RelativeLayout style="@style/VeGo.InputBox">

                    <ImageView
                        android:id="@+id/btn_toggle_confirm"
                        style="@style/VeGo.InputIconButton"
                        android:contentDescription="@string/cd_toggle_password"
                        android:src="@drawable/ic_eye_off" />

                    <EditText
                        android:id="@+id/et_confirm_password"
                        style="@style/VeGo.InputText"
                        android:layout_toStartOf="@id/btn_toggle_confirm"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_confirm_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:paddingEnd="2dp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Thông tin hướng dẫn -->
            <LinearLayout style="@style/VeGo.InfoBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:divider="@drawable/space_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/VeGo.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/change_password_info_title" />

                    <TextView
                        style="@style/VeGo.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/change_password_info_body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_update_password"
                style="@style/VeGo.Button.Primary"
                android:text="@string/change_password_button" />

            <TextView
                android:id="@+id/btn_back_to_account"
                style="@style/VeGo.Button.Outline"
                android:text="@string/change_password_back" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
