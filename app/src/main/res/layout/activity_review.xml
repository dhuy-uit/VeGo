<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Vé & sau chuyến · Đánh giá nhà xe" (node 4:63543) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vego_surface"
    tools:context=".tickets.ReviewActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/VeGo.Header"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/VeGo.HeaderIconButton"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/VeGo.Text.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/review_title" />
    </LinearLayout>

    <ScrollView
        style="@style/VeGo.ScrollArea"
        android:layout_below="@id/header">

        <LinearLayout style="@style/VeGo.Content">

            <!-- Chuyến đã đi -->
            <LinearLayout style="@style/VeGo.Card">

                <TextView
                    style="@style/VeGo.Badge.Mint"
                    android:text="@string/review_trip_done" />

                <TextView
                    android:id="@+id/tv_operator"
                    style="@style/VeGo.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:lineHeight="28sp"
                    android:textSize="19sp"
                    tools:text="Phương Trang" />

                <TextView
                    android:id="@+id/tv_route"
                    style="@style/VeGo.Text.BodyStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="TP. Hồ Chí Minh → Đà Lạt" />

                <TextView
                    android:id="@+id/tv_schedule"
                    style="@style/VeGo.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="22:00 · 20/09/2026 → 05:00 · 21/09/2026" />

                <TextView
                    android:id="@+id/tv_ticket"
                    style="@style/VeGo.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Vé VG20092608 · Ghế B08" />
            </LinearLayout>

            <TextView
                style="@style/VeGo.Text.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/review_question" />

            <!-- 5 ngôi sao -->
            <LinearLayout
                android:id="@+id/group_stars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_12"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/star_1"
                    style="@style/VeGo.Star" />

                <TextView
                    android:id="@+id/star_2"
                    style="@style/VeGo.Star" />

                <TextView
                    android:id="@+id/star_3"
                    style="@style/VeGo.Star" />

                <TextView
                    android:id="@+id/star_4"
                    style="@style/VeGo.Star" />

                <TextView
                    android:id="@+id/star_5"
                    style="@style/VeGo.Star" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_rating_label"
                style="@style/VeGo.Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="@color/vego_primary"
                tools:text="5/5 · Rất hài lòng" />

            <!-- Đánh giá nhanh -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/tag_clean"
                    style="@style/VeGo.Chip"
                    android:text="@string/review_tag_clean" />

                <TextView
                    android:id="@+id/tag_ontime"
                    style="@style/VeGo.Chip"
                    android:text="@string/review_tag_ontime" />

                <TextView
                    android:id="@+id/tag_staff"
                    style="@style/VeGo.Chip"
                    android:text="@string/review_tag_staff" />
            </LinearLayout>

            <!-- Nhận xét -->
            <LinearLayout style="@style/VeGo.Field">

                <TextView
                    style="@style/VeGo.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/et_comment"
                    android:text="@string/review_comment_label" />

                <RelativeLayout style="@style/VeGo.InputBox">

                    <EditText
                        android:id="@+id/et_comment"
                        style="@style/VeGo.InputText"
                        android:gravity="top|start"
                        android:hint="@string/review_comment_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineHeight="20sp"
                        android:maxLength="500"
                        android:maxLines="6"
                        android:minHeight="110dp"
                        android:text="Xe sạch, giường nằm thoải mái. Nhân viên hỗ trợ nhiệt tình, xe khởi hành đúng giờ. Mình sẽ tiếp tục đặt vé!" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Lời nhắc -->
            <LinearLayout style="@style/VeGo.InfoBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:divider="@drawable/space_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/VeGo.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/review_info_title" />

                    <TextView
                        android:id="@+id/tv_review_info"
                        style="@style/VeGo.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Nhận xét được gắn với chuyến đã đi ngày 20/09." />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_submit"
                style="@style/VeGo.Button.Primary"
                android:text="@string/review_submit" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
