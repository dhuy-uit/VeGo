<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Kết nối nhân viên" (node 2002:36) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/VeGo.Card"
    android:divider="@drawable/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_mint"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_headset" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:divider="@drawable/space_2"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                style="@style/VeGo.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/chat_staff_title"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_staff_eta"
                style="@style/VeGo.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_staff_eta" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_call_hotline"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_phone" />

        <TextView
            style="@style/VeGo.Text.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chat_call_hotline"
            android:textColor="@color/vego_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_send_request"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_send_request"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_message_square" />

        <TextView
            android:id="@+id/tv_send_request"
            style="@style/VeGo.Text.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chat_send_request"
            android:textColor="@color/white" />
    </LinearLayout>

    <TextView
        style="@style/VeGo.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineHeight="16sp"
        android:text="@string/chat_staff_note"
        android:textColor="@color/vego_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
