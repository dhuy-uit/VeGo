<?xml version="1.0" encoding="utf-8"?>
<!-- Một ô ngày trong "Tuần của bạn" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_checkin_day"
    android:divider="@drawable/space_8"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="12dp"
    android:paddingEnd="2dp"
    android:paddingBottom="12dp"
    android:showDividers="middle">

    <TextView
        android:id="@+id/tv_day_label"
        style="@style/VeGo.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/vego_text_secondary"
        android:textSize="10sp"
        tools:text="Ngày 1" />

    <ImageView
        android:id="@+id/iv_day_state"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:padding="3dp"
        tools:background="@drawable/bg_tile_mint"
        tools:src="@drawable/ic_check" />

    <TextView
        android:id="@+id/tv_day_date"
        style="@style/VeGo.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:maxLines="1"
        android:textSize="11sp"
        tools:text="15/10" />

    <TextView
        android:id="@+id/tv_day_reward"
        style="@style/VeGo.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/vego_text_secondary"
        android:textSize="10sp"
        tools:text="+20 xu" />
</LinearLayout>
