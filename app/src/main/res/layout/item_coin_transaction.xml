<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng "Lịch sử giao dịch xu" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_tx_icon"
        style="@style/VeGo.TxIcon"
        tools:src="@drawable/ic_calendar_check" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:divider="@drawable/space_2"
        android:orientation="vertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/tv_tx_title"
            style="@style/VeGo.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:lineHeight="20sp"
            android:textSize="14sp"
            tools:text="Điểm danh" />

        <TextView
            android:id="@+id/tv_tx_time"
            style="@style/VeGo.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineHeight="16sp"
            android:textColor="@color/vego_text_secondary"
            android:textSize="11sp"
            tools:text="17/10/2026 · 08:15" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tx_amount"
        style="@style/VeGo.Text.Amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="+20 xu" />
</LinearLayout>
