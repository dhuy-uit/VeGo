<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại chọn một mục trong danh sách (điểm đi / điểm đến), dùng qua VeGoChoiceDialog -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:divider="@drawable/space_12"
        android:orientation="vertical"
        android:padding="20dp"
        android:showDividers="middle">

        <TextView
            android:id="@+id/choice_title"
            style="@style/VeGo.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Chọn điểm đi" />

        <ScrollView
            android:id="@+id/choice_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/choice_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/choice_close"
            style="@style/VeGo.Button.Outline"
            android:layout_height="48dp"
            android:text="@string/action_close" />
    </LinearLayout>
</FrameLayout>
