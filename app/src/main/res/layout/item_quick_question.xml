<?xml version="1.0" encoding="utf-8"?>
<!-- Chip câu hỏi nhanh ở màn chào -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_question_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/iv_quick_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_receipt_text" />

    <TextView
        android:id="@+id/tv_quick_text"
        style="@style/VeGo.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/vego_primary"
        android:textSize="14sp"
        tools:text="Chính sách hủy vé &amp; hoàn tiền" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
