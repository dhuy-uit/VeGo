<?xml version="1.0" encoding="utf-8"?>
<!-- Figma nhóm 07 "Hỗ trợ AI": Màn hình chào (2002:173), Cuộc trò chuyện (2002:123),
     Tra cứu vé trong chat (2002:63), Chuyển nhân viên (2002:2) — cùng một màn, đổi theo nội dung chat -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vego_surface"
    tools:context=".support.SupportChatActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/VeGo.Header"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/VeGo.HeaderIconButton"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_left" />

        <LinearLayout style="@style/VeGo.HeaderTitleBlock">

            <TextView
                style="@style/VeGo.Text.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_title" />

            <TextView
                android:id="@+id/tv_chat_status"
                style="@style/VeGo.Text.HeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <!-- Soạn tin nhắn -->
    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_top_border"
        android:divider="@drawable/space_12"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:showDividers="middle">

        <TextView
            style="@style/VeGo.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineHeight="16sp"
            android:text="@string/chat_disclaimer"
            android:textColor="@color/vego_text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_message"
                style="@style/VeGo.InputText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="@string/chat_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300"
                android:maxLines="4" />

            <ImageView
                android:id="@+id/btn_send"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="@string/cd_send"
                android:padding="16dp"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_chat"
        style="@style/VeGo.ScrollArea"
        android:layout_above="@id/composer"
        android:layout_below="@id/header">

        <LinearLayout
            android:id="@+id/chat_content"
            style="@style/VeGo.Content">

            <!-- Lời chào + câu hỏi nhanh (ẩn sau tin nhắn đầu tiên) -->
            <LinearLayout
                android:id="@+id/group_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_20"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/space_16"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="12dp"
                    android:showDividers="middle">

                    <ImageView
                        android:id="@+id/iv_bot_avatar"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_circle_mint"
                        android:importantForAccessibility="no"
                        android:padding="21dp"
                        android:src="@drawable/ic_bot" />

                    <TextView
                        style="@style/VeGo.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center_horizontal"
                        android:lineHeight="33sp"
                        android:text="@string/chat_welcome_title"
                        android:textSize="23sp" />

                    <TextView
                        style="@style/VeGo.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:text="@string/chat_welcome_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/space_12"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/VeGo.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/chat_quick_title"
                        android:textColor="@color/vego_text_secondary"
                        android:textSize="12sp" />

                    <!-- 4 chip câu hỏi, thêm bằng code -->
                    <LinearLayout
                        android:id="@+id/list_quick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/space_12"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
