<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Vé & sau chuyến · Vé của tôi" (node 4:63390) — tab Vé của tôi -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vego_surface"
    tools:context=".tickets.MyTicketsActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/VeGo.Header"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/VeGo.HeaderIconButton"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/VeGo.Text.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/my_tickets_title" />
    </LinearLayout>

    <!-- Thanh điều hướng dưới -->
    <include
        android:id="@+id/bottom_nav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true" />

    <ScrollView
        style="@style/VeGo.ScrollArea"
        android:layout_above="@id/bottom_nav"
        android:layout_below="@id/header">

        <LinearLayout style="@style/VeGo.Content">

            <!-- Chọn nhóm vé -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_container"
                android:divider="@drawable/space_4"
                android:orientation="horizontal"
                android:padding="4dp"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/tab_upcoming"
                    style="@style/VeGo.SegmentItem"
                    tools:text="Sắp đi (1)" />

                <TextView
                    android:id="@+id/tab_completed"
                    style="@style/VeGo.SegmentItem"
                    tools:text="Đã đi (1)" />

                <TextView
                    android:id="@+id/tab_cancelled"
                    style="@style/VeGo.SegmentItem"
                    tools:text="Đã hủy (1)" />
            </LinearLayout>

            <!-- Các thẻ vé của tab đang chọn (thêm trong MyTicketsActivity) -->
            <LinearLayout
                android:id="@+id/list_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_20"
                android:orientation="vertical"
                android:showDividers="middle" />

            <!-- Khi tab không có vé -->
            <LinearLayout
                android:id="@+id/group_empty"
                style="@style/VeGo.Card"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ticket_check" />

                <TextView
                    android:id="@+id/tv_empty"
                    style="@style/VeGo.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    tools:text="Bạn chưa có chuyến sắp đi." />

                <TextView
                    android:id="@+id/btn_book_now"
                    style="@style/VeGo.Button.Primary"
                    android:text="@string/my_tickets_book_now" />
            </LinearLayout>

            <!-- Lịch sử gần đây (chỉ hiện ở tab Sắp đi, giống Figma) -->
            <TextView
                android:id="@+id/tv_history_title"
                style="@style/VeGo.Text.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/my_tickets_history" />

            <LinearLayout
                android:id="@+id/list_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/space_20"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
